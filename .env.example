# Copy this file to .env and fill in real values. .env is git-ignored and
# should never be committed.

# Database
DB_HOST=db-host-name
DB_NAME=db-name
DB_USERNAME=your-db-username
DB_PASSWORD=db-password

# Bot
BOT_API_KEY=your-botfather-token-here
ADMIN_NUMBER=your-telegram-numeric-id-here
DOMAIN_HOST=your-domain-or-tunnel-host
BOT_USERNAME=your-bot-username-without-at-sign
